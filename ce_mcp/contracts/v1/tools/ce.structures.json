{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "name": "ce.structures",
  "description": "Manage sidecar-owned structure definitions and read one at a generation-bound target base.",
  "inputSchema": {"type": "object", "oneOf": [
    {"type": "object", "required": ["action", "name", "size", "fields"], "properties": {
      "action": {"const": "create"}, "name": {"type": "string", "minLength": 1, "maxLength": 128},
      "size": {"type": "integer", "minimum": 1, "maximum": 65536},
      "fields": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"type": "object"}}
    }, "additionalProperties": false},
    {"type": "object", "required": ["action", "structureId", "expectedRevision", "name", "size", "fields"], "properties": {
      "action": {"const": "update"}, "structureId": {"type": "string", "pattern": "^struct-[0-9a-f]{8}$"},
      "expectedRevision": {"type": "integer", "minimum": 1}, "name": {"type": "string", "minLength": 1, "maxLength": 128},
      "size": {"type": "integer", "minimum": 1, "maximum": 65536},
      "fields": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"type": "object"}}
    }, "additionalProperties": false},
    {"type": "object", "required": ["action"], "properties": {
      "action": {"const": "list"}, "cursor": {"type": "string", "pattern": "^[0-9]{1,10}$"},
      "limit": {"type": "integer", "minimum": 1, "maximum": 100}
    }, "additionalProperties": false},
    {"type": "object", "required": ["action", "structureId"], "properties": {
      "action": {"const": "get"}, "structureId": {"type": "string", "pattern": "^struct-[0-9a-f]{8}$"}
    }, "additionalProperties": false},
    {"type": "object", "required": ["action", "structureId", "expectedRevision"], "properties": {
      "action": {"const": "delete"}, "structureId": {"type": "string", "pattern": "^struct-[0-9a-f]{8}$"},
      "expectedRevision": {"type": "integer", "minimum": 1}
    }, "additionalProperties": false},
    {"type": "object", "required": ["action", "structureId", "base", "expectedGeneration"], "properties": {
      "action": {"const": "read"}, "structureId": {"type": "string", "pattern": "^struct-[0-9a-f]{8}$"},
      "base": {"type": "string", "minLength": 1, "maxLength": 512},
      "expectedGeneration": {"type": "integer", "minimum": 1}
    }, "additionalProperties": false}
  ]},
  "outputSchema": {"type": "object", "required": ["action"], "properties": {
    "action": {"type": "string", "enum": ["create", "update", "list", "get", "delete", "read"]},
    "session": {"type": "object"}, "structure": {"type": "object"},
    "items": {"type": "array", "maxItems": 100, "items": {"type": "object"}},
    "truncated": {"type": "boolean"}, "nextCursor": {"type": "string"},
    "deleted": {"type": "boolean"}, "base": {"type": "object"},
    "values": {"type": "array", "maxItems": 256, "items": {"type": "object"}}
  }, "additionalProperties": false},
  "annotations": {"readOnlyHint": false, "destructiveHint": false, "idempotentHint": false}
}
