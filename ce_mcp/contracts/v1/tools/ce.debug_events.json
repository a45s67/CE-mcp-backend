{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "name": "ce.debug_events",
  "description": "Page bounded debugger stop events for the current target generation.",
  "inputSchema": {"type": "object", "oneOf": [
    {"type": "object", "required": ["action", "expectedGeneration"], "properties": {
      "action": {"const": "list"}, "cursor": {"type": "string", "pattern": "^[0-9]{1,10}$"},
      "limit": {"type": "integer", "minimum": 1, "maximum": 200}, "expectedGeneration": {"type": "integer", "minimum": 1}
    }, "additionalProperties": false}
  ]},
  "outputSchema": {"type": "object", "required": ["action", "session", "items", "truncated"], "properties": {
    "action": {"const": "list"}, "session": {"type": "object"},
    "items": {"type": "array", "items": {"type": "object"}, "maxItems": 200},
    "nextCursor": {"type": "string"}, "truncated": {"type": "boolean"}
  }, "additionalProperties": false},
  "annotations": {"readOnlyHint": true, "destructiveHint": false, "idempotentHint": true}
}
