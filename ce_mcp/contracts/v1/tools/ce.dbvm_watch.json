{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "name": "ce.dbvm_watch",
  "description": "Control bounded, generation-owned DBVM memory watches. Requires matching sidecar/bridge hypervisor policy and user-preloaded DBK/DBVM. CAPABILITY_UNAVAILABLE or CE_API_ERROR may mean the user has not enabled DBK/DBVM, or DBVM became unavailable. Check CE and ce.status; this tool never initializes them.",
  "inputSchema": {"type": "object", "oneOf": [
    {"type":"object","required":["action","expectedGeneration"],"properties":{"action":{"const":"status"},"watchId":{"type":"string","pattern":"^watch-[0-9a-f]{8}-[0-9a-f]{8}$"},"expectedGeneration":{"type":"integer","minimum":1}},"additionalProperties":false},
    {"type":"object","required":["action","address","mode","expectedGeneration"],"properties":{"action":{"const":"start"},"address":{"type":"string","minLength":1,"maxLength":512},"mode":{"type":"string","enum":["write","access","execute"]},"size":{"type":"integer","minimum":1,"maximum":8},"capacity":{"type":"integer","minimum":1,"maximum":1024},"captureStack":{"type":"boolean"},"expectedGeneration":{"type":"integer","minimum":1}},"additionalProperties":false},
    {"type":"object","required":["action","watchId","expectedGeneration"],"properties":{"action":{"const":"events"},"watchId":{"type":"string","pattern":"^watch-[0-9a-f]{8}-[0-9a-f]{8}$"},"cursor":{"type":"string","pattern":"^[0-9]{1,10}$"},"limit":{"type":"integer","minimum":1,"maximum":200},"expectedGeneration":{"type":"integer","minimum":1}},"additionalProperties":false},
    {"type":"object","required":["action","watchId","expectedGeneration"],"properties":{"action":{"const":"stop"},"watchId":{"type":"string","pattern":"^watch-[0-9a-f]{8}-[0-9a-f]{8}$"},"expectedGeneration":{"type":"integer","minimum":1}},"additionalProperties":false}
  ]},
  "outputSchema":{"type":"object","required":["action","session"],"properties":{"action":{"type":"string","enum":["status","start","events","stop"]},"session":{"type":"object"},"watch":{"type":"object"},"items":{"type":"array","items":{"type":"object"},"maxItems":200},"nextCursor":{"type":"string"},"truncated":{"type":"boolean"},"stopped":{"type":"boolean"}},"additionalProperties":false},
  "annotations":{"readOnlyHint":false,"destructiveHint":false,"idempotentHint":false}
}
