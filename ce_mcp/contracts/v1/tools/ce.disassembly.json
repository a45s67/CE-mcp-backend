{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "ce.disassembly",
  "description": "Read instructions or function metadata around a target address. The corrected Lua return mapping makes opcode reliable in current code. Function recovery is heuristic: it stops at the first ret or a read/count bound, not an exact function boundary. byteLimit drives lazy instruction reads and caps returned instruction bytes; decoding the next instruction may read beyond the remaining budget. Inspect completeness before relying on the recovered extent.",
  "inputSchema": {
    "type": "object",
    "oneOf": [
      {
        "type": "object",
        "required": ["action", "address"],
        "properties": {
          "action": {"const": "list"},
          "address": {"type": "string", "minLength": 1, "maxLength": 512},
          "instructionCount": {"type": "integer", "minimum": 1, "maximum": 500},
          "byteLimit": {"type": "integer", "minimum": 1, "maximum": 65536, "description": "Caps returned instruction bytes using lazy reads, not eager full-count decoding. The next instruction may be decoded/read before discovering it exceeds the remaining byte budget; it is then omitted."},
          "expectedGeneration": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      },
      {
        "type": "object",
        "required": ["action", "address"],
        "properties": {
          "action": {"const": "instruction"},
          "address": {"type": "string", "minLength": 1, "maxLength": 512},
          "expectedGeneration": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      },
      {
        "type": "object",
        "required": ["action", "address"],
        "properties": {
          "action": {"const": "function"},
          "address": {"type": "string", "minLength": 1, "maxLength": 512},
          "detail": {"type": "string", "enum": ["summary", "full"], "description": "Both detail levels use heuristic recovery stopping at the first ret or a read/count bound, not exact function boundaries. Completeness does not prove all control-flow paths were recovered."},
          "expectedGeneration": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      },
      {
        "type": "object",
        "required": ["action", "address"],
        "properties": {
          "action": {"const": "previous"},
          "address": {"type": "string", "minLength": 1, "maxLength": 512},
          "count": {"type": "integer", "minimum": 1, "maximum": 100},
          "expectedGeneration": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      },
      {
        "type": "object",
        "required": ["action", "address"],
        "properties": {
          "action": {"const": "next"},
          "address": {"type": "string", "minLength": 1, "maxLength": 512},
          "count": {"type": "integer", "minimum": 1, "maximum": 100},
          "expectedGeneration": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      }
    ]
  },
  "outputSchema": {
    "type": "object",
    "required": ["action", "session"],
    "properties": {
      "action": {"type": "string", "enum": ["list", "instruction", "function", "previous", "next"]},
      "session": {"type": "object"},
      "items": {"type": "array", "items": {"type": "object"}, "maxItems": 500},
      "instruction": {"type": "object"},
      "function": {"type": "object"},
      "truncated": {"type": "boolean"},
      "artifactId": {"type": "string", "minLength": 8, "maxLength": 128}
    },
    "additionalProperties": false
  },
  "annotations": {"readOnlyHint": true, "destructiveHint": false, "idempotentHint": true}
}
