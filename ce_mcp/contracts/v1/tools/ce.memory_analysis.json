{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "name": "ce.memory_analysis",
  "description": "Compare or checksum a bounded target-memory region without mutation or host paths.",
  "inputSchema": {"type": "object", "oneOf": [
    {"type": "object", "required": ["action", "leftAddress", "rightAddress", "size", "expectedGeneration"], "properties": {
      "action": {"const": "compare"}, "leftAddress": {"type": "string", "minLength": 1, "maxLength": 512},
      "rightAddress": {"type": "string", "minLength": 1, "maxLength": 512},
      "size": {"type": "integer", "minimum": 1, "maximum": 1048576},
      "expectedGeneration": {"type": "integer", "minimum": 1}
    }, "additionalProperties": false},
    {"type": "object", "required": ["action", "address", "size", "expectedGeneration"], "properties": {
      "action": {"const": "checksum"}, "address": {"type": "string", "minLength": 1, "maxLength": 512},
      "size": {"type": "integer", "minimum": 1, "maximum": 1048576},
      "algorithm": {"type": "string", "enum": ["md5"]},
      "expectedGeneration": {"type": "integer", "minimum": 1}
    }, "additionalProperties": false}
  ]},
  "outputSchema": {"type": "object", "required": ["action", "session"], "properties": {
    "action": {"type": "string", "enum": ["compare", "checksum"]}, "session": {"type": "object"},
    "equal": {"type": "boolean"}, "firstDifference": {"type": "integer", "minimum": 0},
    "size": {"type": "integer", "minimum": 1, "maximum": 1048576},
    "algorithm": {"type": "string", "enum": ["md5"]},
    "digest": {"type": "string", "pattern": "^[0-9a-fA-F]{32}$"}
  }, "additionalProperties": false},
  "annotations": {"readOnlyHint": true, "destructiveHint": false, "idempotentHint": true}
}
