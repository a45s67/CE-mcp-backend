{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "ce.scan",
  "description": "Start/refine a bounded CE memory scan, page completed results, or close its session-bound handle.",
  "inputSchema": {
    "type": "object",
    "oneOf": [
      {
        "type": "object",
        "required": ["action", "scanType", "valueType", "value", "expectedGeneration"],
        "properties": {
          "action": {"const": "start"}, "scanType": {"const": "exact"},
          "valueType": {"type": "string", "enum": ["u8", "i16", "i32", "i64", "f32", "f64", "string", "aob"]},
          "value": {"type": "string", "minLength": 1, "maxLength": 4096},
          "rangeStart": {"type": "string", "pattern": "^(0x)?[0-9A-Fa-f]{1,16}$"},
          "rangeEnd": {"type": "string", "pattern": "^(0x)?[0-9A-Fa-f]{1,16}$"},
          "protection": {"type": "string", "pattern": "^[+\\-*][Ww][+\\-*][Xx][+\\-*][Cc]$"},
          "alignment": {"type": "integer", "minimum": 1, "maximum": 4096},
          "hexadecimal": {"type": "boolean"}, "unicode": {"type": "boolean"},
          "caseSensitive": {"type": "boolean"}, "expectedGeneration": {"type": "integer", "minimum": 1}
        }, "additionalProperties": false
      },
      {
        "type": "object",
        "required": ["action", "scanType", "valueType", "value", "value2", "expectedGeneration"],
        "properties": {
          "action": {"const": "start"}, "scanType": {"const": "between"},
          "valueType": {"type": "string", "enum": ["u8", "i16", "i32", "i64", "f32", "f64"]},
          "value": {"type": "string", "minLength": 1, "maxLength": 128},
          "value2": {"type": "string", "minLength": 1, "maxLength": 128},
          "rangeStart": {"type": "string", "pattern": "^(0x)?[0-9A-Fa-f]{1,16}$"},
          "rangeEnd": {"type": "string", "pattern": "^(0x)?[0-9A-Fa-f]{1,16}$"},
          "protection": {"type": "string", "pattern": "^[+\\-*][Ww][+\\-*][Xx][+\\-*][Cc]$"},
          "alignment": {"type": "integer", "minimum": 1, "maximum": 4096},
          "hexadecimal": {"type": "boolean"}, "expectedGeneration": {"type": "integer", "minimum": 1}
        }, "additionalProperties": false
      },
      {
        "type": "object",
        "required": ["action", "scanType", "valueType", "expectedGeneration"],
        "properties": {
          "action": {"const": "start"}, "scanType": {"const": "unknown"},
          "valueType": {"type": "string", "enum": ["u8", "i16", "i32", "i64", "f32", "f64"]},
          "rangeStart": {"type": "string", "pattern": "^(0x)?[0-9A-Fa-f]{1,16}$"},
          "rangeEnd": {"type": "string", "pattern": "^(0x)?[0-9A-Fa-f]{1,16}$"},
          "protection": {"type": "string", "pattern": "^[+\\-*][Ww][+\\-*][Xx][+\\-*][Cc]$"},
          "alignment": {"type": "integer", "minimum": 1, "maximum": 4096},
          "expectedGeneration": {"type": "integer", "minimum": 1}
        }, "additionalProperties": false
      },
      {
        "type": "object",
        "required": ["action", "operationId", "scanType", "expectedGeneration"],
        "properties": {
          "action": {"const": "refine"}, "operationId": {"type": "string", "pattern": "^scan-[0-9a-f]{8}-[0-9a-f]{8}$"},
          "scanType": {"type": "string", "enum": ["exact", "between", "bigger", "smaller", "increased", "decreased", "changed", "unchanged"]},
          "value": {"type": "string", "minLength": 1, "maxLength": 4096},
          "value2": {"type": "string", "minLength": 1, "maxLength": 128},
          "hexadecimal": {"type": "boolean"}, "unicode": {"type": "boolean"},
          "caseSensitive": {"type": "boolean"}, "expectedGeneration": {"type": "integer", "minimum": 1}
        }, "additionalProperties": false
      },
      {
        "type": "object", "required": ["action", "operationId", "expectedGeneration"],
        "properties": {"action": {"const": "results"}, "operationId": {"type": "string", "pattern": "^scan-[0-9a-f]{8}-[0-9a-f]{8}$"}, "cursor": {"type": "string", "maxLength": 256}, "limit": {"type": "integer", "minimum": 1, "maximum": 200}, "expectedGeneration": {"type": "integer", "minimum": 1}},
        "additionalProperties": false
      },
      {
        "type": "object", "required": ["action", "operationId", "expectedGeneration"],
        "properties": {"action": {"const": "close"}, "operationId": {"type": "string", "pattern": "^scan-[0-9a-f]{8}-[0-9a-f]{8}$"}, "expectedGeneration": {"type": "integer", "minimum": 1}},
        "additionalProperties": false
      }
    ]
  },
  "outputSchema": {
    "type": "object", "required": ["action", "session"],
    "properties": {
      "action": {"type": "string", "enum": ["start", "refine", "results", "close"]},
      "session": {"type": "object"}, "operation": {"type": "object"}, "closed": {"type": "boolean"},
      "items": {"type": "array", "items": {"type": "object"}, "maxItems": 200},
      "nextCursor": {"type": "string", "maxLength": 256}, "truncated": {"type": "boolean"}, "total": {"type": "integer", "minimum": 0}
    }, "additionalProperties": false
  },
  "annotations": {"readOnlyHint": false, "destructiveHint": false, "idempotentHint": false}
}
