{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "required": ["protocolVersion", "requestId", "result"],
      "properties": {
        "protocolVersion": {"const": 1},
        "requestId": {"type": "string", "minLength": 8, "maxLength": 128},
        "result": {"type": "object"}
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["protocolVersion", "requestId", "error"],
      "properties": {
        "protocolVersion": {"const": 1},
        "requestId": {"type": "string", "minLength": 8, "maxLength": 128},
        "error": {
          "type": "object",
          "required": ["code", "message", "recoverable", "safeToRetry"],
          "properties": {
            "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"},
            "message": {"type": "string", "minLength": 1, "maxLength": 512},
            "recoverable": {"type": "boolean"},
            "safeToRetry": {"type": "boolean"},
            "currentState": {"type": "string", "maxLength": 64},
            "suggestedAction": {"type": "string", "maxLength": 512},
            "details": {"type": "object"},
            "adviceSource": {"const": "ce-mcp-backend"},
            "nextActions": {
              "type": "array", "maxItems": 4,
              "items": {
                "type": "object",
                "required": ["code", "execution", "reason"],
                "properties": {
                  "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"},
                  "execution": {"type": "string", "enum": ["suggested", "required_before_retry", "manual"]},
                  "reason": {"type": "string", "minLength": 1, "maxLength": 256},
                  "tool": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"},
                  "arguments": {"type": "object", "maxProperties": 32},
                  "argumentsPatch": {"type": "object", "maxProperties": 16},
                  "preserveArguments": {"type": "array", "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 64}}
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  ]
}
