{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["protocolVersion", "requestId", "method", "params", "deadlineMs"],
  "properties": {
    "protocolVersion": {"const": 1},
    "requestId": {"type": "string", "minLength": 8, "maxLength": 128},
    "sessionId": {"type": "string", "minLength": 8, "maxLength": 128},
    "method": {"type": "string", "minLength": 3, "maxLength": 128},
    "params": {"type": "object"},
    "deadlineMs": {"type": "integer", "minimum": 1, "maximum": 300000}
  },
  "additionalProperties": false
}
